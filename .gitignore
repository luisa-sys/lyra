# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# database backups (created by scripts/backup-database.sh)
/backups

# typescript
*.tsbuildinfo
next-env.d.ts
coverage/

# Mutation testing reports
reports/mutation/*.json
reports/mutation/*.html
reports/weekly-report-*.md

# Playwright (KAN-114, KAN-176)
playwright-report/
test-results/
# KAN-348: authed harness storageState + manifest — LIVE session tokens.
# Runtime-only; must NEVER be committed or uploaded as a public CI artifact.
tests/e2e/.auth/

# Lighthouse CI output (KAN-176)
.lighthouseci/

# KAN-467 QA sweep artefacts. `inventory.py` and `coverage.py` regenerate
# qa-inventory.json and qa-coverage.json (~300KB each) on every run, so a
# committed copy is stale the moment anything under src/ changes — and a stale
# denominator is the specific failure this tool exists to avoid. The scripts are
# the source of truth; run them.
qa-sweep/*.json

# Python bytecode cache (generated by scripts/ python tests during test:scripts)
__pycache__/
*.pyc

# macOS / iCloud Finder duplicates (KAN-357 · CTL-010 · BUGS-76 session)
# iCloud Drive silently creates byte-identical " 2" copies on sync conflict.
# On 2026-07-27 it produced SEVEN of these inside supabase/migrations/, where a
# "foo 2.sql" shares its version prefix with "foo.sql" and therefore manufactures
# a duplicate-migration-version violation — the exact BUGS-49 / BUGS-75 defect
# class that has now recurred twice and shipped a fix to production.
#
# CTL-010 (scripts/check-macos-duplicate-files.sh) rejects these once COMMITTED.
# Ignoring them makes an accidental `git add` impossible rather than merely
# detected — prevention over detection, per docs/DEFECT_FEEDBACK_LOOP.md §3(b).
# Scoped to code/config extensions only: .md is deliberately NOT listed so a
# legitimately-named document ("Phase 2.md") is never silently hidden.
* [2-9].sql
* [2-9].ts
* [2-9].tsx
* [2-9].js
* [2-9].cjs
* [2-9].mjs
* [2-9].py
* [2-9].json
* [2-9].yml
* [2-9].yaml
* [2-9].sh
* [2-9]/
